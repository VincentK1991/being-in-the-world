@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <urn:shacl:example:> .

ex:ClaimShape a sh:NodeShape ;
    sh:targetClass ex:Claim ;
    sh:property [ sh:path ex:policy ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:message "A claim must reference one policy." ] ;
    sh:property [ sh:path ex:reserve ; sh:minCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 0 ; sh:message "Reserve must be a nonnegative integer." ] ;
    sh:property [ sh:path ex:description ; sh:minCount 1 ; sh:severity sh:Warning ;
                  sh:message "Add a description to improve search." ] ;
    sh:property [ sh:path ex:reference ; sh:minCount 1 ; sh:severity sh:Info ;
                  sh:message "An external reference would help reconciliation." ] .
