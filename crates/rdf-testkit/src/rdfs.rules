[rdf1: (?x ?p ?y) -> (?p <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>)]
[rdfs2: (?p <http://www.w3.org/2000/01/rdf-schema#domain> ?c) (?x ?p ?y) -> (?x <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?c)]
[rdfs3: (?p <http://www.w3.org/2000/01/rdf-schema#range> ?c) (?x ?p ?y) -> (?y <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?c)]
[rdfs4a: (?x ?p ?y) -> (?x <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2000/01/rdf-schema#Resource>)]
[rdfs4b: (?x ?p ?y) -> (?y <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2000/01/rdf-schema#Resource>)]
[rdfs5: (?p <http://www.w3.org/2000/01/rdf-schema#subPropertyOf> ?q) (?q <http://www.w3.org/2000/01/rdf-schema#subPropertyOf> ?r) -> (?p <http://www.w3.org/2000/01/rdf-schema#subPropertyOf> ?r)]
[rdfs6: (?p <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property>) -> (?p <http://www.w3.org/2000/01/rdf-schema#subPropertyOf> ?p)]
[rdfs7: (?p <http://www.w3.org/2000/01/rdf-schema#subPropertyOf> ?q) (?x ?p ?y) -> (?x ?q ?y)]
[rdfs8: (?c <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2000/01/rdf-schema#Class>) -> (?c <http://www.w3.org/2000/01/rdf-schema#subClassOf> <http://www.w3.org/2000/01/rdf-schema#Resource>)]
[rdfs9: (?c <http://www.w3.org/2000/01/rdf-schema#subClassOf> ?d) (?x <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?c) -> (?x <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?d)]
